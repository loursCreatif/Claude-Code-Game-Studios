; Proto Player imported from prototypes/movement-katana — Mac-compatible
; (uses Input.is_physical_key_pressed direct, bypass action map).
[gd_scene load_steps=6 format=3 uid="uid://proto_player_etage01"]

[ext_resource type="Script" path="res://scenes/levels/proto_player.gd" id="1_player"]
[ext_resource type="Script" path="res://scenes/levels/proto_katana.gd" id="2_katana"]

[sub_resource type="CapsuleShape3D" id="CapsulePlayer"]
radius = 0.4
height = 1.8

[sub_resource type="CapsuleShape3D" id="CapsuleKatana"]
radius = 0.9
height = 2.6

[sub_resource type="BoxMesh" id="BoxKatana"]
size = Vector3(0.05, 0.05, 1.0)

[sub_resource type="StandardMaterial3D" id="MatKatana"]
albedo_color = Color(0.9, 0.95, 1.0, 1)
metallic = 0.9
roughness = 0.15
emission_enabled = true
emission = Color(0.6, 0.8, 1.0, 1)
emission_energy_multiplier = 0.6

[node name="Player" type="CharacterBody3D"]
collision_layer = 1
collision_mask = 30
; CCD anti-tunneling murs 0.3 m à haute vitesse (dash 28 m/s × dt 0.0167 = 0.47 m/frame).
motion_mode = 0
floor_max_angle = 0.785398
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
shape = SubResource("CapsulePlayer")

[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.65, 0)
current = true
fov = 90.0

[node name="Katana" type="Node3D" parent="Camera3D"]
