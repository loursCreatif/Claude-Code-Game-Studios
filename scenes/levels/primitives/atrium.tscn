; Convention authoring : instance de cette scène dans un Room_NN via
; [node name="Atrium_01" instance=ExtResource("atrium")]
; Contenu : 2 floor/ceiling (void frame) + 4 walls + 2 wall-run guides (visuels seuls)
;   = 8 MeshInstance3D / 6 StaticBody3D.
; Les wall-run guides sont MeshInstance3D sans StaticBody3D (surfaces visuelles).
; Layer collision : LAYER_ENVIRONMENT (layer 4, décimal 8 — bit 3 set, conforme ADR-0008 D-2).
; Shader cible : assets/shaders/chrome_zen_flat.gdshader (story-022).
; TODO story-022 : remplacer StandardMaterial3D par ShaderMaterial chrome_zen_flat.
[gd_scene format=3 uid="uid://primitive_atrium"]

; --- Materials MVP ---
; TODO story-022 : remplacer par SubResource ShaderMaterial chrome_zen_flat
[sub_resource type="StandardMaterial3D" id="mat_floor"]
albedo_color = Color(0.35, 0.37, 0.40, 1)

[sub_resource type="StandardMaterial3D" id="mat_wall"]
albedo_color = Color(0.55, 0.55, 0.58, 1)

[sub_resource type="StandardMaterial3D" id="mat_wall_run_guide"]
; Accent cyan vif pour signaler wall-run-able (MVP playtest visibility).
albedo_color = Color(0.3, 0.85, 0.95, 1)
emission_enabled = true
emission = Color(0.3, 0.85, 0.95, 1)
emission_energy_multiplier = 0.3

; --- Shapes ---
[sub_resource type="BoxShape3D" id="shape_floor"]
size = Vector3(8.0, 0.3, 8.0)

[sub_resource type="BoxShape3D" id="shape_ceiling"]
size = Vector3(8.0, 0.3, 8.0)

[sub_resource type="BoxShape3D" id="shape_wall_ns"]
size = Vector3(8.0, 4.0, 0.3)

[sub_resource type="BoxShape3D" id="shape_wall_ew"]
size = Vector3(0.3, 4.0, 8.0)

; --- Meshes ---
[sub_resource type="BoxMesh" id="mesh_floor"]
size = Vector3(8.0, 0.3, 8.0)
material = SubResource("mat_floor")

[sub_resource type="BoxMesh" id="mesh_ceiling"]
size = Vector3(8.0, 0.3, 8.0)
material = SubResource("mat_wall")

[sub_resource type="BoxMesh" id="mesh_wall_ns"]
size = Vector3(8.0, 4.0, 0.3)
material = SubResource("mat_wall")

[sub_resource type="BoxMesh" id="mesh_wall_ew"]
size = Vector3(0.3, 4.0, 8.0)
material = SubResource("mat_wall")

[sub_resource type="BoxMesh" id="mesh_wall_run_guide"]
size = Vector3(6.0, 2.0, 0.1)
material = SubResource("mat_wall_run_guide")

[node name="Atrium" type="Node3D"]

[node name="Floor" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
collision_layer = 8
collision_mask = 0

[node name="FloorMesh" type="MeshInstance3D" parent="Floor"]
mesh = SubResource("mesh_floor")

[node name="FloorShape" type="CollisionShape3D" parent="Floor"]
shape = SubResource("shape_floor")

[node name="Ceiling" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 4.0, 0)
collision_layer = 8
collision_mask = 0

[node name="CeilingMesh" type="MeshInstance3D" parent="Ceiling"]
mesh = SubResource("mesh_ceiling")

[node name="CeilingShape" type="CollisionShape3D" parent="Ceiling"]
shape = SubResource("shape_ceiling")

[node name="WallNorth" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.0, -4.0)
collision_layer = 8
collision_mask = 0

[node name="WallNorthMesh" type="MeshInstance3D" parent="WallNorth"]
mesh = SubResource("mesh_wall_ns")

[node name="WallNorthShape" type="CollisionShape3D" parent="WallNorth"]
shape = SubResource("shape_wall_ns")

[node name="WallSouth" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.0, 4.0)
collision_layer = 8
collision_mask = 0

[node name="WallSouthMesh" type="MeshInstance3D" parent="WallSouth"]
mesh = SubResource("mesh_wall_ns")

[node name="WallSouthShape" type="CollisionShape3D" parent="WallSouth"]
shape = SubResource("shape_wall_ns")

[node name="WallEast" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 4.0, 2.0, 0)
collision_layer = 8
collision_mask = 0

[node name="WallEastMesh" type="MeshInstance3D" parent="WallEast"]
mesh = SubResource("mesh_wall_ew")

[node name="WallEastShape" type="CollisionShape3D" parent="WallEast"]
shape = SubResource("shape_wall_ew")

[node name="WallWest" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -4.0, 2.0, 0)
collision_layer = 8
collision_mask = 0

[node name="WallWestMesh" type="MeshInstance3D" parent="WallWest"]
mesh = SubResource("mesh_wall_ew")

[node name="WallWestShape" type="CollisionShape3D" parent="WallWest"]
