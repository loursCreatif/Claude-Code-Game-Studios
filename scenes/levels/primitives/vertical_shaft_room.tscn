; Convention authoring CRITIQUE : l'instance de cette scène dans un Room_NN DOIT
; être nommée "VerticalShaftRoom" ou "VerticalShaftRoom_NN" (préfixe obligatoire)
; pour satisfaire le check lint `_has_vertical_shaft_room_child()` (AC-LVL-55).
;
; Exemple correct dans le .tscn parent :
;   [node name="VerticalShaftRoom_01" instance=ExtResource("vertical_shaft_room")]
;
; Contenu : floor + 4 walls perimeter (physique) + 2 wall-run inner surfaces (visuels)
;   + 1 Marker3D ceiling (top of shaft) + 1 Marker3D floor (spawn)
;   = 8 MeshInstance3D / 5 StaticBody3D / 2 Marker3D.
; Rise minimum : 8m (walls 10m height, floor à y=0, ceiling marker à y=10).
; Layer collision : LAYER_ENVIRONMENT (layer 4, décimal 8 — bit 3 set, conforme ADR-0008 D-2).
; Shader cible : assets/shaders/chrome_zen_flat.gdshader (story-022).
; TODO story-022 : remplacer StandardMaterial3D par ShaderMaterial chrome_zen_flat.
[gd_scene format=3 uid="uid://primitive_vertical_shaft_room"]

[node name="VerticalShaftRoom" type="Node3D"]

[node name="PitFloor" type="StaticBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, 0)
collision_layer = 8
collision_mask = 0

