[sub_resource type="Environment" id="env_main"]
background_mode = 2
sky = SubResource("sky_res")
; ambient_light_source = 2 (Color seule) — évite que sky teinte les murs en cyan.
ambient_light_source = 2
ambient_light_color = Color(0.78, 0.80, 0.85, 1)
ambient_light_energy = 1.4
; Glow désactivé — pulsation 3s persistante. À ré-activer plus tard avec config stable.
glow_enabled = false
; Fog Chrome Spire — léger pour distance sans noircir le top.
fog_enabled = true
fog_light_color = Color(0.25, 0.32, 0.45, 1)
fog_density = 0.003
fog_sky_affect = 0.1
; Tonemap linear pour stabilité (ACES cause pulsation perçue selon Martin playtest).
tonemap_mode = 0
tonemap_exposure = 1.0
; Désactive auto-exposure (cause variations luminosité chaque 3s).
auto_exposure_enabled = false

