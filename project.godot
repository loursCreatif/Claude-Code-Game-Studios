; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chrome Ascent"
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

InputManager="*res://src/core/input_manager.gd"
GameStateManager="*res://src/core/game_state_manager.gd"
SaveLoadSystem="*res://src/core/save_load_system.gd"
AudioSystem="*res://src/core/audio_system.gd"
AccessibilityService="*res://src/core/accessibility_service.gd"
CreditEconomy="*res://src/core/credit_economy.gd"
Upgrade="*res://src/gameplay/upgrade/upgrade_system.gd"
LevelSystem="*res://src/gameplay/level/level_system.gd"
HUDSystem="*res://src/gameplay/hud/hud_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

